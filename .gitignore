# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Secrets — never commit credentials
.env
*.env
*.pem
*.key
*.token
secrets.*

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Git identities (do not commit)
git_identities.json

# Rendered output
*.exr
out/
renders/
examples/cases/outputs/

# C++ engine build artifacts
core/build/
*.ppm

# shared op-log runtime artifact (Save/Load round-trips it; not source)
mirage_oplog.json

# ImGui runtime layout (generated)
imgui.ini

# local agent config / instructions — never publish
.claude/

# generated PBR texture maps (regenerated deterministically by mirage.textures) — 57 MB, not source
assets/textures/
# generated decal artwork (redrawn deterministically by mirage.decals) — output, not source
assets/decals/

# never publish the CCTV-reference side-by-side (embeds third-party security footage)
docs/gallery/forecourt_compare.png

# a working copy that must not render locally (see capture.default_render)
.render-remote-only

# Case 27 reference data — pulled read-only from the customer's capture host, not ours to
# commit. `git add -A` once swept 310 MB of it into a public commit; the sources beside it
# ARE repo content, so this ignores the data and not the case.
examples/cases/fuelcap/_ref/
examples/cases/fuelcap/_out/
